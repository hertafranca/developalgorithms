Algoritmo "Pares 2 e 1000"
// Descrição   : Elabore um algoritmo que possibilite calcular
//a soma de todos os números pares compreendidos entre 2 e 1000.
// Autor(a)    : Herta França
// Data atual  : 04/11/2026
Var
// Seção de Declarações das variáveis 

i,soma:inteiro


Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
  soma<-0
  para i de 2 ate 1000 passo 2 faca
   escreval("Valor de i:",i)
   soma <- soma + i
  fimpara
  escreval("A soma dos números pares é: ", soma)
  

Fimalgoritmo