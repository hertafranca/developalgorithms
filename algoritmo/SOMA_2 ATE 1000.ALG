Algoritmo "Soma_2 ate 1000"
// Descrição   : Elabore um algoritmo que possibilite calcular
// a soma de todos os números pares compreendidos entre 2 e 1000.
// Autor(a)    : Herta França
// Data atual  : 04/11/2026
Var
// Seção de Declarações das variáveis 
       i,soma: inteiro

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
          i<-2
          soma<-0
  enquanto i <= 1000 faca

   soma <- soma + i
   i<-i +2
   
  fimenquanto
  escreval("A soma dos números pares é: ", soma)

Fimalgoritmo